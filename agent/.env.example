APP_NAME=codesentinel-ai
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
JAVA_SERVICE_URL=http://localhost:8080
PR_CONTEXT_TIMEOUT=30
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=120
# 单次 Review 请求的服务端总时间预算（秒）。默认 100 = PR Context 局部上限 30s + DeepSeek 局部上限 60s + 10s 汇总余量；
# 须小于 Worker 的 AI_SERVICE_TIMEOUT（默认 120s），确保服务端先于 Worker 放弃等待而显式结束（成功或失败）。
REVIEW_TOTAL_BUDGET=100

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60
DEEPSEEK_TEMPERATURE=0.1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TASK_QUEUE=codesentinel:review:tasks

# ----------------------------------------------------------
# Static analysis (Phase 8.6)
# ----------------------------------------------------------
# 是否在 Review 流程中执行静态分析工具；工具缺失时结果按契约标记
# UNAVAILABLE（绝不以“扫描成功且零发现”呈现）
STATIC_ANALYSIS_ENABLED=true
STATIC_ANALYSIS_RUFF_EXECUTABLE=ruff
STATIC_ANALYSIS_BANDIT_EXECUTABLE=bandit
STATIC_ANALYSIS_SEMGREP_EXECUTABLE=semgrep
# Semgrep 必须使用被审仓库之外的可信规则配置；留空则 Semgrep 跳过并报告 not_configured
STATIC_ANALYSIS_SEMGREP_CONFIG=