APP_NAME=codesentinel-ai
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
JAVA_SERVICE_URL=http://localhost:8080
PR_CONTEXT_TIMEOUT=30
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_TIMEOUT=120
# 单次 Review 请求的服务端总时间预算（秒）。默认 100 = PR Context 局部上限 30s + DeepSeek 局部上限 60s + 10s 汇总余量；
# 须小于 Worker 的 AI_SERVICE_TIMEOUT（默认 120s），确保服务端先于 Worker 放弃等待而显式结束（成功或失败）。
REVIEW_TOTAL_BUDGET=100

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TIMEOUT=60
DEEPSEEK_TEMPERATURE=0.1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TASK_QUEUE=codesentinel:review:tasks