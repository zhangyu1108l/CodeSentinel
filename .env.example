# ============================================================
# CodeSentinel Environment Variables
# ============================================================
# 复制此文件为 .env 并填写本地开发配置

# ----------------------------------------------------------
# MySQL
# ----------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=codesentinel
MYSQL_USER=codesentinel
MYSQL_PASSWORD=codesentinel_dev
MYSQL_ROOT_PASSWORD=root_dev_password

# ----------------------------------------------------------
# Redis
# ----------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ----------------------------------------------------------
# Spring Boot
# ----------------------------------------------------------
SPRING_SERVER_PORT=8080

# ----------------------------------------------------------
# FastAPI / Python AI Service
# ----------------------------------------------------------
APP_NAME=codesentinel-ai
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ----------------------------------------------------------
# DeepSeek API (Phase 5+ 使用，当前留空)
# ----------------------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ----------------------------------------------------------
# GitHub App (Phase 2+ 使用)
# ----------------------------------------------------------
# App ID: 在 GitHub App Settings → General 中查看
GITHUB_APP_ID=
# 方式一（推荐）：将 .pem 文件放入 secrets/ 目录，填写相对路径
GITHUB_PRIVATE_KEY_PATH=
# 方式二（不推荐）：直接粘贴 PEM 文件内容（注意换行符处理）
GITHUB_PRIVATE_KEY=
# Webhook Secret: 在 GitHub App Settings → Webhook 中设置
GITHUB_WEBHOOK_SECRET=
# Installation ID: 在 GitHub App → Installations 中查看
GITHUB_INSTALLATION_ID=
# GitHub API Base URL (默认 https://api.github.com)
GITHUB_API_BASE_URL=https://api.github.com